# Email (Resend). Without RESEND_API_KEY the form actions log the payload and return success (dev only).
RESEND_API_KEY=
CONTACT_TO_EMAIL=info@healmedllc.com
CONTACT_FROM_EMAIL=website@healmedllc.com

# Cloudflare Turnstile. Test keys for local dev:
#   site 1x00000000000000000000AA  secret 1x0000000000000000000000000000000AA
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Vercel Blob (Offer form uploads)
BLOB_READ_WRITE_TOKEN=

NEXT_PUBLIC_SITE_URL=https://healmedllc.com
